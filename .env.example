ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Login (Supabase). Sem essas variáveis o login roda em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (servidor) — necessária para getAdminClient() (gravações ignorando RLS).
SUPABASE_SECRET_KEY=
# Redis (Upstash) — cache de leitura de "Meus processos". Sem essas variáveis, a leitura cai direto no Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DataJud (CNJ) — enriquece processos já encontrados com dados oficiais de todos os tribunais.
# Chave pública, mas pode mudar: ver https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Infosimples — busca de processos por CPF em 14 tribunais.
INFOSIMPLES_API_TOKEN=
# Limite por fonte da Infosimples, em segundos (padrão 240; na Vercel a varredura toda cabe em 300s).
INFOSIMPLES_TIMEOUT_SEGUNDOS=
# Lemit — enriquecimento cadastral por CPF (api.lemit.com.br), disparado automaticamente nas buscas.
LEMIT_API_TOKEN=
# Valor de contrato por consulta, em R$ (a API da Lemit não informa preço). Ex.: 0.35
LEMIT_CUSTO_POR_CONSULTA=
# Máximo de CPFs achados nos processos enviados à Lemit por busca (padrão 5).
LEMIT_MAX_CPFS_POR_BUSCA=
# Reconsulta noturna (Vercel Cron -> /api/cron/reconsulta). Protege o endpoint
# contra chamadas externas; a Vercel injeta esse mesmo valor no header Authorization do cron.
CRON_SECRET=
# Resend — envio do alerta "processo andou" (avisar_movimentacao) por e-mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Fallback do teto de orçamento diário do cron (centavos) quando a tabela ap_configuracoes não tiver
# a chave 'reconsulta_orcamento_diario_centavos' (normalmente não precisa setar — ajuste pela tabela).
RECONSULTA_ORCAMENTO_DIARIO_CENTAVOS=
# A reconsulta usa só o DataJud (gratuito). 'true' inclui todos os serviços Infosimples do tribunal (pago, por processo/noite).
RECONSULTA_USAR_INFOSIMPLES=
# WhatsApp Cloud API (oficial da Meta) — alerta "processo andou" com resumo IA. Sem as 3 primeiras é no-op.
# O template (categoria Utilidade) precisa de 4 variáveis no corpo: nº do processo, tribunal, resumo, próximo passo (ver lib/whatsapp.ts).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ANDAMENTO=
# Chave HMAC do link "não quero mais receber" dos e-mails (opcional; sem ela usa SUPABASE_SECRET_KEY).
# Trocar a chave invalida os links já enviados.
DESCADASTRO_SECRET=
# Opcionais: idioma do template (padrão pt_BR) e versão da Graph API (padrão v23.0).
WHATSAPP_TEMPLATE_IDIOMA=
WHATSAPP_GRAPH_VERSION=
