ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Webhook incoming do Bitrix24. Usado por crm.lead.add (captura de lead).
BITRIX_WEBHOOK_URL=
# Login (Supabase). Sem essas variáveis o login roda em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (servidor) — necessária para getAdminClient() (gravações ignorando RLS).
SUPABASE_SECRET_KEY=
# Redis (Upstash) — cache de leitura de "Meus processos". Sem essas variáveis, a leitura cai direto no Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DataJud (CNJ) — enriquece processos já encontrados com dados oficiais de todos os tribunais.
# Chave pública, mas pode mudar: ver https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Infosimples — busca de processos por CPF em 14 tribunais.
INFOSIMPLES_API_TOKEN=
# Reconsulta noturna do CRM jurídico (Vercel Cron -> /api/cron/reconsulta). Protege o endpoint
# contra chamadas externas; a Vercel injeta esse mesmo valor no header Authorization do cron.
CRON_SECRET=
# Resend — envio do alerta "processo andou" (avisar_movimentacao) por e-mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Fallback do teto de orçamento diário do cron (centavos) quando a tabela ap_configuracoes não tiver
# a chave 'reconsulta_orcamento_diario_centavos' (normalmente não precisa setar — ajuste pela tabela).
RECONSULTA_ORCAMENTO_DIARIO_CENTAVOS=
