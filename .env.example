ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Webhook incoming do Bitrix24. Usado por crm.lead.add (captura de lead) e também pela
# automação de funis (crm.dealcategory.list/crm.status.list/crm.deal.list) — mesma URL base.
BITRIX_WEBHOOK_URL=
# Segredo próprio (gerado por nós, não vem do Bitrix) para validar o webhook de SAÍDA do Bitrix
# (ONCRMDEALADD/ONCRMDEALUPDATE) que chama .../api/automacao/bitrix/webhook?secret=<isto>.
# Gere com: openssl rand -hex 32
BITRIX_WEBHOOK_SECRET=
# Login (Supabase). Sem essas variáveis o login roda em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (servidor) — necessária para getAdminClient() (gravações ignorando RLS).
SUPABASE_SECRET_KEY=
# Redis (Upstash) — cache de leitura de "Meus processos". Sem essas variáveis, a leitura cai direto no Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DataJud (CNJ) — enriquece processos já encontrados com dados oficiais de todos os tribunais.
# Chave pública, mas pode mudar: ver https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Infosimples — busca de processos por CPF em 14 tribunais.
INFOSIMPLES_API_TOKEN=
