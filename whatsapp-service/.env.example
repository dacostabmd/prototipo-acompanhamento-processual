# Porta HTTP deste serviço (padrão 3333 se não setado).
PORT=3333

# Token compartilhado que o Next.js (Prosec) deve enviar no header `Authorization: Bearer <token>`
# para chamar POST /enviar e GET /status deste serviço. Gere um valor aleatório longo (ex: openssl
# rand -hex 32) — o mesmo valor vai em WHATSAPP_SERVICE_TOKEN no .env do projeto Next.js.
WHATSAPP_SERVICE_TOKEN=

# Pasta onde a sessão do Baileys (credenciais de pareamento com o WhatsApp) fica persistida em
# disco. Não apague entre reinícios do processo, ou será necessário escanear o QR code de novo.
WHATSAPP_SESSION_PATH=./sessao-whatsapp

# URL do endpoint do Next.js (Prosec) que recebe mensagens de WhatsApp recebidas (webhook).
# Ex: https://prosec.vercel.app/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=

# Segredo compartilhado enviado no header `Authorization: Bearer <segredo>` de cada chamada ao
# webhook acima. O Next.js valida esse valor antes de aceitar a mensagem. Gere outro valor aleatório
# distinto de WHATSAPP_SERVICE_TOKEN — o mesmo valor vai em WHATSAPP_WEBHOOK_SECRET no .env do Prosec.
WHATSAPP_WEBHOOK_SECRET=

# Nível de log do Baileys (pino): 'warn' por padrão para não poluir o terminal; use 'debug' só para
# investigar problemas de conexão.
WHATSAPP_LOG_LEVEL=warn
